        "value": {
          "type": "text",
          "value": "Career Academies",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Small high-school learning communities that combine academic and career-themed curricula with employer partnerships and work-based learning. The linked study evaluates a multi-component Academy model, not a single course.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Career Academy group members earned an average 11% more per year than controls over the eight-year follow-up ($2,088 in 2006 dollars).",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The report attributes a total $16,704 earnings gain over eight years to the randomized Academy offer. This is a historical 2006-dollar labor-market result, not a current wage estimate or benefit-cost ratio.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      },

          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "MDRC’s eight-year randomized follow-up of Career Academies on work, education and transitions to adulthood.",

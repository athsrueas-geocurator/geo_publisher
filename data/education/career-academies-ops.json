        },
        "value": {
          "type": "text",
          "value": "USD per year, 2006 dollars; Academy-minus-control average over eight years.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []

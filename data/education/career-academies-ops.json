    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "The Career Academies evaluation randomly assigned applicants in nine high schools and followed outcomes for eight years after scheduled graduation.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The MDRC report draws on more than 1,400 young people, most Hispanic or African-American, in a diverse set of participating sites. It evaluates Academies that sustained their core features; scope should not be generalized to partial implementations.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      }
    ],
    "unset": []
  },

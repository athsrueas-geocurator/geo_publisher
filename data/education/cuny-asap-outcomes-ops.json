        },
        "value": {
          "type": "text",
          "value": "Eight years after study entry, CUNY ASAP increased associate-degree receipt by 12 percentage points (52% versus 39.9%).",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "MDRC reports this program-versus-control result for the original CUNY randomized trial. It is an eight-year associate-degree outcome, not a result for Ohio ASAP or a later CUNY follow-up.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }

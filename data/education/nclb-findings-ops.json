        },
        "value": {
          "type": "text",
          "value": "Dee and Jacob found no evidence that NCLB increased fourth- or eighth-grade reading achievement.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This is the paper’s reported null finding for reading in fourth and eighth grade under its comparative interrupted time-series analysis of NAEP state panels. It does not mean that every reading estimate was exactly zero.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

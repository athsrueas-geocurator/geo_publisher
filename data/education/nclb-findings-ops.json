    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Dee and Jacob estimated that NCLB increased average fourth-grade math performance by an effect size of 0.22 by 2007.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Using state-level NAEP panel data and a comparative interrupted time-series design, the paper reports a statistically significant fourth-grade math increase by 2007. The abstract reports no standard error and does not further define the effect-size scale; retain it as source-reported rather than automatically normalize it.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      },
      {
        "property": {
          "$bytes": "e500e2585a964d2c9df4a47b199616c3"
        },
        "value": {
          "type": "decimal",
          "exponent": -2,
          "mantissa": {
            "type": "i64",
            "value": {
              "$bigint": "22"
            }
          }
        }
      },
      {
        "property": {
          "$bytes": "8405509cc7354655a348591349a5f025"
        },
        "value": {
          "type": "text",
          "value": "Effect size as reported in the NBER abstract; scale not further specified there.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },

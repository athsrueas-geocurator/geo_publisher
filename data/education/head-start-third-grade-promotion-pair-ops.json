        },
        "value": {
          "type": "text",
          "value": "Regression-adjusted parent-reported probability impact on promotion to the next grade at third grade, Head Start access minus control; 3-year-old cohort; lower is less favorable.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "ba643714da274c37a340a7f8396198dc"

        },
        "value": {
          "type": "text",
          "value": "For children entering Head Start at age three, the third-grade promotion ITT impact was -0.02 (p = .092).",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Parents reported promotion for 94% of the Head Start group and 95% of controls; lower promotion means more grade retention. This suggestive result is one school-performance outcome, paired with its IOT counterpart rather than independent evidence.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },

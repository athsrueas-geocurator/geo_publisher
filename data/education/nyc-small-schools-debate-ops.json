    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Large urban districts should expand small, nonselective high-school options when lottery evidence shows sustained attainment gains.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "New York City SSC enrollment raised graduation, immediate college enrollment, and six-year four-year-degree attainment in a lottery-based evaluation. Earlier cost accounting favored SSCs per graduate but lacks a common price year and complete resource accounting.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

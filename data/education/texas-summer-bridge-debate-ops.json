        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Community colleges should scale developmental summer bridge programs based on early course gains.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The randomized Texas study found higher first-fall college-level math attempt and pass rates and higher writing pass rates. The evidence is preliminary, the programs varied across eight colleges, fall registration did not differ significantly, and the source reports resources rather than cost effectiveness.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

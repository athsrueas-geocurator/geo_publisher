    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Interpreting the findings",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "e3e363d1dd294ccb8e6ff3b76d99bc33"
        },
        "value": {
          "type": "text",
          "value": "The comparison is an offer of Head Start access versus available alternative care, not universal absence of services. The 2010 report follows children through first grade; the 2012 report extends follow-up through third grade. Numeric rows use native scores or fractions, not a common standardized scale. Read each unit and reporter before interpreting the direction. ITT describes assignment; IOT adjusts for participation and is available here only for selected outcomes. Linked ITT/IOT pairs are alternate estimands from the same study, not independent replications. Some reported results meet only a 10% significance threshold. These selected published findings are not a complete transcription of every exhibit; missing SEs and sample counts remain unknown.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },

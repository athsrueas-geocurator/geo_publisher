    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "States should treat PACE’s short-term school gains as insufficient evidence for statewide expansion.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "PACE’s randomized evaluation found improved first-year attendance, on-track status, credit success, and suspension outcomes, but no statistically significant 18-month difference in juvenile-justice charges. The same source reports a $10,400 net societal service cost per program-group girl and says its short follow-up cannot establish later graduation, delinquency, or full cost-effectiveness outcomes.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": false
        }
      }
    ],
    "unset": []
  },

  {
    "type": "updateEntity",
    "id": {
      "$bytes": "68b02f7a1980436e9bdb6fd908278a5c"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "The third-grade Head Start follow-up reports that modest early language and literacy effects left one impact in each age cohort by the end of third grade.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This source-specific follow-up statement preserves the report’s cohort structure and its distinction between early effects and third-grade measurement. It is not a claim about unmeasured later-life outcomes.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      }
    ],
    "unset": []
  },

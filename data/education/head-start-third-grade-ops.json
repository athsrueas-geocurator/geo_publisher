        "value": {
          "type": "text",
          "value": "Third Grade Follow-up to the Head Start Impact Study: Final Report",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The 2012 federal follow-up of the Head Start randomized study, reporting outcomes through the end of third grade.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "412ff593e9154012a43d4c27ec5c68b6"

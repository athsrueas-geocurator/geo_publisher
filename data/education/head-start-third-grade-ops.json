    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "The third-grade Head Start follow-up found that social-emotional results differed by age cohort and by whether parents, teachers or children reported them.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The report describes favorable and unfavorable findings for different reporters and cohorts. Do not aggregate these into one universal social-emotional effect or treat reporter differences as a contradiction without outcome-level review.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {

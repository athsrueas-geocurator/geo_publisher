        },
        "value": {
          "type": "text",
          "value": "USD difference in average annual earnings in year nine after random assignment; current dollars.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {

      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Project QUEST randomly assigned 410 San Antonio adults seeking health-care training to program or control groups.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Between 2006 and 2008, 207 people were assigned to Project QUEST and 203 to control; the report uses regression-adjusted intent-to-treat estimates. The evidence is specific to this health-care-focused support model and study sample.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      },
      {
        "property": {
          "$bytes": "84dacbddca6a44079edb5e11a4c66b40"
        },
        "value": {
          "type": "text",
          "value": "Randomized design and full administrative-data sample.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "210e9b352b454d6eb7a32906d24d3c8d"

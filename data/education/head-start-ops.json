        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "In the Head Start Impact Study, children offered Head Start were twice as likely as controls to use a center-based program in spring 2003.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This randomized-study finding concerns the early care arrangement produced by an offer of Head Start, not a comparison with no alternative services. The report includes Head Start, preschool and child care in its center-based category.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {

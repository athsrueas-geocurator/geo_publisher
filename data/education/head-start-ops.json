        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This policy question is open for debate. Linked factual Claims separate early outcomes and care access from the study’s limited sample-wide first-grade differences.",

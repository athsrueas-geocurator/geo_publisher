        },
        "value": {
          "type": "text",
          "value": "The Head Start Impact Study compared Head Start access with a mix of alternative care arrangements, not with a universal no-service condition.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"

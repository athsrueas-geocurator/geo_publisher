      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "The Head Start Impact Study found favorable cognitive and health impacts after one program year, with more significant findings for the 3-year-old cohort.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The final report describes end-of-program-year impacts for the randomized access comparison. It does not justify treating every measured outcome, later follow-up, or implementation setting as favorable.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {

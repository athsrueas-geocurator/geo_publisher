        "value": {
          "type": "text",
          "value": "National Teacher and Principal Survey (NTPS) and Teacher Follow-up Survey (TFS)",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "NTPS and TFS provide nationally representative teacher and school workforce context. They do not identify effects of a local initiative without a separate credible design.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "412ff593e9154012a43d4c27ec5c68b6"
        },
        "value": {
          "type": "text",

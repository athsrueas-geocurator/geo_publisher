        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "College Scorecard provides institution- and cohort-level postsecondary completion, earnings, debt, repayment, and aid data. It supplies pathway and return context; it does not establish that an initiative caused an outcome.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

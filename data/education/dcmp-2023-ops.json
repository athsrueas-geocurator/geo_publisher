        },
        "value": {
          "type": "text",
          "value": "The five-year outcome difference was not statistically significant, so it is not generalizable evidence of a long-term attainment effect.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

        },
        "value": {
          "type": "text",
          "value": "By third grade, Head Start had no statistically significant impact on measured parent-reported health outcomes in either entry-age cohort.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The report’s parent-reported dental care, insurance coverage, overall health, ongoing-care need, and recent-injury measures show no statistically significant third-grade ITT effect in either cohort. The study collected no direct examinations, health records, or provider reports.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }

    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Districts should consider well-evaluated ethnic-studies expansion when local evidence shows sustained GPA and course-failure improvements.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The linked San Francisco expansion study reports improved overall and subject GPA plus fewer course failures under a student-level difference-in-differences design. Its results concern one district’s implementation and enrollment patterns, so they support careful local evaluation rather than a prediction that every expansion will have the same effects.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": false
        }
      }
    ],
    "unset": []
  },

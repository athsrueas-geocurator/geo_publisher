        },
        "value": {
          "type": "text",
          "value": "Tutoring effects were stronger on average for teachers and paraprofessionals than for nonprofessional and parent tutors.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Nickow, Oreopoulos and Quan (2020) report this comparison in the meta-analysis abstract. It is an average subgroup pattern across heterogeneous experiments, not a guarantee for every tutor or program.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

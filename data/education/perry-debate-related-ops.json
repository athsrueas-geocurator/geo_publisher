[
  {
    "type": "updateEntity",
    "id": {
      "$bytes": "6d0c8aeccbfa424c8224d8d993070052"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Perry's economic returns are sufficient grounds to expand publicly funded preschool for disadvantaged children.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This policy judgment favors expansion based on Perry's modeled long-term benefits. Whether those benefits would transfer to new programs remains a separate evidentiary question.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": false
        }
      }
    ],
    "unset": []

      },
      "hanushek": {
        "name": "Evidence, Politics, and the Class Size Debate",
        "author": "Eric A. Hanushek",
        "url": "https://hanushek.stanford.edu/publications/evidence-politics-and-class-size-debate",
        "description": "Eric Hanushek’s chapter in The Class Size Debate (2002), edited by Lawrence Mishel and Richard Rothstein, pages 37–65. It critiques class-size evidence and broad reduction policies."
      }
    },
    "claims": [
      {
        "key": "economic-case",
        "name": "STAR-sized early-grade class reductions can be worth their cost.",
        "description": "Krueger (2003) argues that modest achievement gains can justify reducing classes from 22 to 15 pupils in grades K–3. His earnings-based case is conditional on modeled returns, not observed lifetime benefits.",
        "source": "krueger",
        "locator": "Section 3, F61; Section 2.2, Table 5, F56–F58; caveats F58–F59",
        "factual": false
      },
      {
        "key": "weighting",
        "name": "Counting studies equally strengthens the evidence that smaller classes improve achievement.",
        "description": "Krueger (2003) finds that reweighting 277 estimates from 59 studies reveals a positive relationship obscured by counting every estimate equally. This is a contested literature interpretation, not a new experiment.",
        "source": "krueger",
        "locator": "Section 1, Table 2; Section 3, F59–F60",
        "factual": false
      },
      {
        "key": "quality",
        "name": "Equal study weights do not resolve bias in class-size research.",
        "description": "Hanushek (2002) argues that Krueger’s reweighting favors weaker estimates. He emphasizes omitted state policies and prior educational inputs when judging study quality.",
        "source": "hanushek",
        "locator": "Chapter 2, The importance of quality, printed pp. 46–50; conclusion p. 61",
        "factual": false
      },
      {
        "key": "broad-policy",
        "name": "STAR does not justify across-the-board class-size reductions.",
        "description": "Hanushek (2002) argues that broad reductions are too costly for the benefits established by existing evidence. He allows that reductions can be worthwhile in particular circumstances.",
        "source": "hanushek",
        "locator": "Chapter 2, Conclusions, printed p. 61",
        "factual": false
      },
      {
        "key": "projection-risk",
        "name": "Projected earnings alone are too uncertain to justify large class-size reductions.",
        "description": "Hanushek (2002) challenges the compounded assumptions connecting early test gains to lifetime earnings. He also argues that policy choices must consider alternatives such as improving teacher quality.",
        "source": "hanushek",
        "locator": "Chapter 2, Policy calculations, printed pp. 58–60",
        "factual": false
      },
      {
        "key": "star-scope",
        "name": "STAR’s early gains do not establish benefits from smaller classes in later grades.",
        "description": "Hanushek (2002) interprets STAR’s advantage as concentrated at initial entry into small classes. He disputes extrapolation to later grades or smaller reductions, rather than claiming that no students benefit.",
        "source": "hanushek",
        "locator": "Chapter 2, The Tennessee class size experiment, printed pp. 55–58",
        "factual": false
      }
    ],

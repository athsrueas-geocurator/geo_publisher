      {
        "property": {
          "$bytes": "412ff593e9154012a43d4c27ec5c68b6"
        },
        "value": {
          "type": "text",
          "value": "https://journals.sagepub.com/doi/10.3102/00028312231208687",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],

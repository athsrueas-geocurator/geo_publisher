    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Public preschool should be judged on later educational attainment and behavior, not standardized test scores alone.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This policy position weighs Boston’s null standardized-test estimates alongside its reported college, graduation, SAT-taking, and disciplinary findings. The lottery evidence is about historical Boston applicants and does not establish that every public pre-K program will have the same later outcomes.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

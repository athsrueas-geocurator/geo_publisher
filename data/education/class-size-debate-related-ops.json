  {
    "type": "createRelation",
    "id": {
      "$bytes": "12807aed301e401dbe10dc8ef9de8724"
    },
    "entity": {
      "$bytes": "7688d484a7f4487ab5b937c804b6ebf8"
    },
    "from": {
      "$bytes": "21388c169ed84bbdbd26f529c390fc54"
    },
    "to": {
      "$bytes": "d70f7e00c8fd4fb2b6a056df6b844b1f"
    },
    "relationType": {
      "$bytes": "49c5d5e1679a4dbdbfd33f618f227c94"
    }
  },
  {
    "type": "updateEntity",
    "id": {
      "$bytes": "c050382dc2614403916342d43d2ef87a"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Equal study weights do not resolve bias in class-size research.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Hanushek (2002) argues that Krueger’s reweighting favors weaker estimates. He emphasizes omitted state policies and prior educational inputs when judging study quality.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },
  {
    "type": "createRelation",
    "id": {
      "$bytes": "8cfc0ea893764c9483235e6acd9d8991"
    },
    "entity": {
      "$bytes": "84d26f4fe1a8461290b86305359141d4"
    },
    "from": {
      "$bytes": "c050382dc2614403916342d43d2ef87a"
    },
    "to": {
      "$bytes": "96f859efa1ca4b229372c86ad58b694b"
    },
    "relationType": {
      "$bytes": "8f151ba4de204e3c9cb499ddf96f48f1"
    }
  },
  {
    "type": "updateEntity",
    "id": {
      "$bytes": "c050382dc2614403916342d43d2ef87a"
    },
    "set": [
      {
        "property": {

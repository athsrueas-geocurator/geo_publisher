      "$bytes": "4bb85899505a459da17ec72990eab81c"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Class-size reduction",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Reducing the number of pupils taught together in a classroom.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },
  {
    "type": "createRelation",
    "id": {
      "$bytes": "51cbfeb3f7674567885b10603305efb4"
    },
    "entity": {
      "$bytes": "da58042f6b7c4cd1b63c58a6eaa73cbf"
    },
    "from": {
      "$bytes": "4bb85899505a459da17ec72990eab81c"
    },
    "to": {
      "$bytes": "5ef5a5860f274d8e8f6c59ae5b3e89e2"
    },
    "relationType": {
      "$bytes": "8f151ba4de204e3c9cb499ddf96f48f1"
    }
  },
  {
    "type": "updateEntity",
    "id": {
      "$bytes": "44e2a08c02e74fdaaaa6f112e1581fb5"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "STAR-sized early-grade class reductions can be worth their cost.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Krueger (2003) argues that modest achievement gains can justify reducing classes from 22 to 15 pupils in grades K–3. His earnings-based case is conditional on modeled returns, not observed lifetime benefits.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },
  {
    "type": "createRelation",
    "id": {
      "$bytes": "28ba63eacb6146ca8946e71ec15a3ae4"
    },
    "entity": {
      "$bytes": "574213920f4b462ca63578f03e47c73b"
    },
    "from": {
      "$bytes": "44e2a08c02e74fdaaaa6f112e1581fb5"
    },
    "to": {
      "$bytes": "96f859efa1ca4b229372c86ad58b694b"
    },
    "relationType": {
      "$bytes": "8f151ba4de204e3c9cb499ddf96f48f1"
    }
  },
  {
    "type": "updateEntity",
    "id": {
      "$bytes": "44e2a08c02e74fdaaaa6f112e1581fb5"
    },
    "set": [
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {

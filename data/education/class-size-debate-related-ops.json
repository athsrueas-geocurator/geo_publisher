          "value": false
        }
      },
      {
        "property": {
          "$bytes": "84dacbddca6a44079edb5e11a4c66b40"
        },
        "value": {
          "type": "text",
          "value": "Chapter 2, The importance of quality, printed pp. 46–50; conclusion p. 61",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },
  {
    "type": "createRelation",

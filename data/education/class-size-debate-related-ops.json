          "value": false
        }
      },
      {
        "property": {
          "$bytes": "84dacbddca6a44079edb5e11a4c66b40"
        },
        "value": {
          "type": "text",
          "value": "Section 3, F61; Section 2.2, Table 5, F56–F58; caveats F58–F59",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },
  {
    "type": "createRelation",
    "id": {
      "$bytes": "96a3f811e5a244bab063c8728341fe50"
    },
    "entity": {
      "$bytes": "549535f7bd524d94a3f1d3956e1cb578"
    },
    "from": {
      "$bytes": "44e2a08c02e74fdaaaa6f112e1581fb5"
    },
    "to": {
      "$bytes": "d70f7e00c8fd4fb2b6a056df6b844b1f"
    },
    "relationType": {
      "$bytes": "49c5d5e1679a4dbdbfd33f618f227c94"
    }
  },
  {
    "type": "updateEntity",
    "id": {
      "$bytes": "21388c169ed84bbdbd26f529c390fc54"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Counting studies equally strengthens the evidence that smaller classes improve achievement.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Krueger (2003) finds that reweighting 277 estimates from 59 studies reveals a positive relationship obscured by counting every estimate equally. This is a contested literature interpretation, not a new experiment.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },
  {
    "type": "createRelation",
    "id": {
      "$bytes": "dcfcdb68a10e40a7b8c73153d6485c5c"
    },
    "entity": {
      "$bytes": "66f9df5c9a804230b830dac0a8123340"
    },
    "from": {
      "$bytes": "21388c169ed84bbdbd26f529c390fc54"
    },
    "to": {
      "$bytes": "96f859efa1ca4b229372c86ad58b694b"
    },
    "relationType": {
      "$bytes": "8f151ba4de204e3c9cb499ddf96f48f1"
    }
  },
  {

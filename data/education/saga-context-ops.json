          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Saga Chicago tutoring study 2 (2014–2015)",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "A separate randomized tutoring evaluation in 15 Chicago public high schools during 2014–2015. The sample included female and male students and retained duplicate randomization records.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "03b87ec1e71f410db566c7f12920283d"
        },
        "value": {
          "type": "integer",
          "value": {
            "$bigint": "2"
          }
        }
      },
      {
        "property": {
          "$bytes": "7a1f6d017895206e84e1988c0c74621e"
        },
        "value": {
          "type": "text",
          "value": "Female and male students, mostly entering grade 9 with some grade 10, in selected Chicago public high schools, 2014–2015",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "8e46e3eff9dea2b55d32a5ca7de61938"
        },
        "value": {
          "type": "text",
          "value": "Randomized controlled trial; one-year tutoring offer; no independent Becoming a Man randomization",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "c962e0fb4a3148e5ba125144691236a8"
        },
        "value": {
          "type": "text",
          "value": "Year-one estimates: 2014–2015 academic year; tutoring offer one year",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "84dacbddca6a44079edb5e11a4c66b40"
        },
        "value": {
          "type": "text",
          "value": "Printed pp. 741–743, footnote 10; Table 4, p. 750",

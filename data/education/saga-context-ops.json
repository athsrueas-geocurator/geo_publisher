  {
    "type": "updateEntity",
    "id": {
      "$bytes": "6ff69ada18b54b1db98375da1b90df65"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Saga Chicago tutoring study 1 (2013–2014)",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "A randomized tutoring evaluation in 12 Chicago public high schools beginning in the 2013–2014 school year. Its male-student sample also underwent independent randomization to Becoming a Man.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "03b87ec1e71f410db566c7f12920283d"
        },
        "value": {
          "type": "integer",
          "value": {
            "$bigint": "1"
          }
        }
      },
      {
        "property": {
          "$bytes": "7a1f6d017895206e84e1988c0c74621e"
        },
        "value": {
          "type": "text",
          "value": "Male students entering grades 9 or 10 in selected Chicago public high schools, 2013–2014",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "8e46e3eff9dea2b55d32a5ca7de61938"
        },
        "value": {
          "type": "text",
          "value": "Randomized controlled trial; 2 × 2 factorial assignment with independent Becoming a Man assignment",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "c962e0fb4a3148e5ba125144691236a8"
        },
        "value": {
          "type": "text",
          "value": "Year-one estimates: 2013–2014 academic year; tutoring offer up to two years",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "84dacbddca6a44079edb5e11a4c66b40"
        },
        "value": {
          "type": "text",
          "value": "Printed pp. 741–743; Table 3, p. 749",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },

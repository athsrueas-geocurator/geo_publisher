          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "A nonprofit supporting high-impact tutoring in U.S. schools. Formerly SAGA Innovations, it developed from Match Education's tutoring work.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

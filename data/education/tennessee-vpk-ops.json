        },
        "value": {
          "type": "text",
          "value": "Tennessee Voluntary Pre-K Program",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Tennessee’s state-funded voluntary pre-K program for eligible children. The linked randomized evaluation concerns oversubscribed sites and its study-period comparison conditions.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }

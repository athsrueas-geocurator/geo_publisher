  {
    "type": "updateEntity",
    "id": {
      "$bytes": "3b87b7c104cb44a6b82e8db91c163dc9"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "In the Tennessee Voluntary Pre-K trial, teacher behavior ratings showed no overall group advantage, while later school records included more rule violations and persistent special-education designations for pre-K participants.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The article reports heterogeneous results, including some favorable effects for male and Black children on selected ratings and attendance. These school-record patterns do not identify the mechanism or generalize automatically beyond the evaluated program.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      }
    ],
    "unset": []
  },

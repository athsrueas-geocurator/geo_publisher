  {
    "type": "updateEntity",
    "id": {
      "$bytes": "3356d0eba4e54eeeab1db7a8d9691077"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "In the Tennessee Voluntary Pre-K trial, children offered pre-K did not perform as well as controls on third-grade state achievement tests.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The paper reports early test advantages at the end of pre-K, then control-group catch-up in kindergarten and later grades. This outcome does not establish effects on unmeasured later-life outcomes or every achievement instrument.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      }
    ],
    "unset": []
  },

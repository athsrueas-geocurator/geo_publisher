  {
    "type": "updateEntity",
    "id": {
      "$bytes": "4fbfa11f56634a2a9206e79db9dc1d6a"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "The Tennessee Voluntary Pre-K evaluation randomly assigned 2,990 low-income applicants to receive admission offers or remain on a waiting list.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "State education records followed the full randomized sample from pre-K through third grade; an additional consented subsample had 1,076 children. This is a waiting-list offer comparison in Tennessee, not a result for every public pre-K model.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      }
    ],
    "unset": []
  },

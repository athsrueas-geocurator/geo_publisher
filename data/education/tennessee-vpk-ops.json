        "value": {
          "type": "text",
          "value": "Effects of the Tennessee Prekindergarten Program on children’s achievement and behavior through third grade",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "A 2018 open-access report of Tennessee’s statewide randomized voluntary pre-K evaluation through third grade.",

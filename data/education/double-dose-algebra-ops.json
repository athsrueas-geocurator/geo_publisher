  {
    "type": "updateEntity",
    "id": {
      "$bytes": "e6b77d5b70184fbcb447bf2b471f9122"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Chicago’s double-dose algebra policy assigned ninth graders below the national-median eighth-grade math score to two periods of algebra coursework.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The policy doubled math instructional time and also changed peer composition and pedagogy. Its regression-discontinuity evidence applies near the assignment threshold, not to every student or every implementation.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      }
    ],
    "unset": []
  },

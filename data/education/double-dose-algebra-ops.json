        "value": {
          "type": "text",
          "value": "Intensive Math Instruction and Educational Attainment: Long-Run Impacts of Double-Dose Algebra",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Cortes, Goodman and Nomi’s study of Chicago double-dose algebra and longer-run educational attainment.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

        },
        "value": {
          "type": "text",
          "value": "Comprehensive teacher induction",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "An induction model using trained full-time mentors, instructional support, professional development, observation, and feedback for beginning teachers. The study distinguishes one- and two-year district implementations.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

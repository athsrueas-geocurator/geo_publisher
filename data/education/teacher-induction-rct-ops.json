        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "A federal randomized evaluation of comprehensive induction for beginning teachers, with three-year achievement and retention follow-up.",

        "value": {
          "type": "text",
          "value": "Two years of comprehensive induction increased year-three reading scores by 0.11 SD in the benchmark sample.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Table V.5 reports p=.018 for 1,347 students of 74 teachers in six two-year districts. The result depends on the current-and-prior-test benchmark sample and is not a one-year induction result.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

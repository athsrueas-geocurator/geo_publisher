        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The source reports OR=4.60 (95% CI 1.21–17.47; p=.03) for the ABC randomized treatment comparison. It corresponds to 12 treated and 3 control participants, so it is a small-sample estimate and ABC-only.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

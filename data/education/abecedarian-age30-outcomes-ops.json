        },
        "value": {
          "type": "text",
          "value": "Cohen's d for completed years of education at age 30, ABC treatment versus control; source-reported standardized effect.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []

          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The source reports OR=2.65, χ²(1)=5.16, p=.02 for the ABC randomized treatment comparison. This is an employment-history threshold, not earnings or a cost-benefit result.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

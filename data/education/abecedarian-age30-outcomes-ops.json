      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The selected primary economic outcome had F(1,99)=1.61, p=.21, d=0.25 in 52 treated and 49 control participants. This does not establish no economic effect; it is one age-30, self-reported household-income measure.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

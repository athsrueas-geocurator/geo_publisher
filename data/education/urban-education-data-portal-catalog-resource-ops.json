          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Urban Institute Education Data Portal provides programmatic access to selected public education data. It supplies delivery and field-shape context; it does not establish that an initiative caused an outcome.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {

        },
        "value": {
          "type": "text",
          "value": "Tennessee should reconsider expanding its voluntary pre-K model on the basis of short-term readiness gains alone.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This policy proposition weighs the trial’s early pre-K test gains against its later third-grade achievement finding and mixed school-record outcomes. One Tennessee evaluation does not settle the value of every public pre-K model, delivery approach, or policy objective.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "For students near San Francisco’s 2.0 eighth-grade-GPA cutoff, taking ethnic studies increased ninth-grade attendance by 21 percentage points.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The authors derive this local IV estimate from the fuzzy assignment rule; the reduced-form attendance discontinuity is 6.328 points (robust SE 2.201; N=1,404). It applies near this threshold in the high-fidelity pilot, not to all students or ethnic-studies courses.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      },
      {
        "property": {
          "$bytes": "e500e2585a964d2c9df4a47b199616c3"
        },
        "value": {
          "type": "decimal",
          "exponent": -2,
          "mantissa": {
            "type": "i64",
            "value": {
              "$bigint": "21"
            }
          }
        }
      },
      {
        "property": {
          "$bytes": "210e9b352b454d6eb7a32906d24d3c8d"
        },
        "value": {
          "type": "integer",
          "value": {
            "$bigint": "1404"

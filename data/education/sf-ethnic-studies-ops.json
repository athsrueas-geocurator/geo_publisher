      {
        "property": {
          "$bytes": "8405509cc7354655a348591349a5f025"
        },
        "value": {
          "type": "text",
          "value": "Percentage-point local-IV effect of taking San Francisco ethnic studies on ninth-grade attendance near the 2.0 GPA cutoff.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }

        },
        "value": {
          "type": "text",
          "value": "Districts should expand Early College High Schools when local partnerships can deliver their documented degree gains at comparable cost.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "AIR’s admissions-lottery study found higher Year-10 degree attainment after an Early College offer. Its separate six-site cost-benefit model is favorable but depends on modeled lifetime returns and has substantial site variation.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

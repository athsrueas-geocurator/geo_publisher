        },
        "value": {
          "type": "text",
          "value": "Intention-to-treat estimate; standard error 0.035; outcome-complete N=1852. Table 3, p. 749, panel A. Outcome-complete observations; baseline-adjusted models. Study 2 retains 65 duplicate randomizations and clusters standard errors by student. ITT and TOT describe the same trials, not independent evidence.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }

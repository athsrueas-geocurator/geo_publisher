        },
        "value": {
          "type": "text",
          "value": "Early Warning Intervention and Monitoring System (EWIMS)",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "A seven-step early-warning process that uses attendance, behavior and course-performance data to identify students, assign supports and monitor progress. The linked trial evaluates one first-year implementation, not every local data tool.",

    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "After one year, EWIMS showed no statistically significant effect on insufficient credits for on-time graduation (14% in each group).",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This is the report’s first-year null result for progress in school. It does not establish that the exact effect was zero or rule out later changes in graduation.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      },
      {
        "property": {
          "$bytes": "e500e2585a964d2c9df4a47b199616c3"
        },
        "value": {
          "type": "decimal",
          "exponent": 0,
          "mantissa": {
            "type": "i64",
            "value": {
              "$bigint": "0"
            }
          }
        }
      },
      {
        "property": {
          "$bytes": "8405509cc7354655a348591349a5f025"
        },
        "value": {
          "type": "text",
          "value": "Percentage-point difference in insufficient-credits risk: EWIMS minus control, after one year; reported 14% in both groups.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }

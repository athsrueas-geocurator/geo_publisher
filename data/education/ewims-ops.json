        },
        "value": {
          "type": "text",
          "value": "After one year, EWIMS schools had a 5-percentage-point lower rate of failing one or more courses than control schools (21% versus 26%).",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The source reports this model-adjusted difference as statistically significant after one year of adoption. It is a course-failure risk result, not a graduation-rate estimate.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {

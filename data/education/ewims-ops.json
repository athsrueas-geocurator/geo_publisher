          "type": "decimal",
          "exponent": 0,
          "mantissa": {
            "type": "i64",
            "value": {
              "$bigint": "-4"
            }
          }
        }
      },
      {
        "property": {
          "$bytes": "8405509cc7354655a348591349a5f025"
        },
        "value": {
          "type": "text",
          "value": "Percentage-point difference in chronic-absence risk: EWIMS minus control, after one year.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],

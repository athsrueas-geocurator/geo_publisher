      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "The ASAP Ohio Demonstration randomly assigned 1,501 low-income community-college students to program or usual services.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The 2015–2016 Ohio replication covered Cincinnati State, Cuyahoga, and Lorain County community colleges. The program group had 806 students and the control group had 695; this is a replication of the CUNY ASAP model, not the original New York City trial.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true
        }
      },
      {
        "property": {
          "$bytes": "84dacbddca6a44079edb5e11a4c66b40"
        },
        "value": {
          "type": "text",
          "value": "pp. 2–3.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []

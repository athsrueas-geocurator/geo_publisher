        },
        "value": {
          "type": "text",
          "value": "Figure 2 and Growing Gains in Annual Earnings; printed pp. 5–6 / PDF pp. 6–7.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "e500e2585a964d2c9df4a47b199616c3"
        },

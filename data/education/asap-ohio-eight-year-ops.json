        },
        "value": {
          "type": "text",
          "value": "Figure 1 and Eight-Year Follow-Up; pp. 3–4.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {

        "value": {
          "type": "text",
          "value": "After eight years, ASAP Ohio increased degree receipt by 15 percentage points (46% versus 31%).",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This full-sample randomized estimate covers degree receipt after eight years. It is evidence from the Ohio replication and must remain distinct from the original CUNY trial’s completion outcomes.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true

      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "In year eight, ASAP Ohio increased average annual earnings by $3,337 ($27,934 versus $24,596).",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "The report’s Ohio unemployment-insurance wage-record analysis includes 1,482 of 1,501 randomized students and omits wages earned outside Ohio. The source does not state a price year, so this dollar difference is not normalized or used as a benefit-cost measure.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {
          "type": "boolean",
          "value": true

[
  {
    "type": "updateEntity",
    "id": {
      "$bytes": "430852724e084021b8f43d252646c8fc"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Across four WorkAdvance sites, assignment increased 2018 earnings by $2,716.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Across all four sites, 2018 earnings were $26,419 for WorkAdvance and $23,703 for control participants (p = .003). This pooled finding is not a provider-specific result.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },
  {
    "type": "updateEntity",
    "id": {
      "$bytes": "74367c0ffb3b46b0aa84df113b274eb6"
    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Across four WorkAdvance sites, assignment increased earning $30,000 or more in 2018 by 6.4 percentage points.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "In the pooled sample, 40.0% of WorkAdvance and 33.7% of control participants earned at least $30,000 in 2018 (p = .001). The report-specific threshold and pooled result can mask provider variation.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },
  {

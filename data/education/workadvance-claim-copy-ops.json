    },
    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "At Per Scholas, WorkAdvance assignment increased 2018 earnings by $6,281.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This randomized site-specific National Directory of New Hires estimate has p = .004. It is a 2018 earnings difference, not a general employment-rate effect.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },

        },
        "value": {
          "type": "text",
          "value": "The adjusted original-CUNY randomized-trial estimate has p < .001 in the 896-student sample. Degree receipt is cumulative at any college over three years, not a later earnings or benefit-cost result.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

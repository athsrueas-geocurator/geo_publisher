          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "The CUNY ASAP evaluation randomly assigned 896 low-income students needing one or two developmental courses to program or usual services.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "MDRC evaluated ASAP at Borough of Manhattan, Kingsborough, and LaGuardia community colleges. The full randomized sample has 451 program-group and 445 control-group students; this is the original CUNY trial, not an ASAP replication.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"

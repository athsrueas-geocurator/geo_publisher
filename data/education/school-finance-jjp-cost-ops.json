          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "A reported model of incremental spending for a sustained increase in school resources. Interpret it with the price year, discount rate and separate reproduction limitations.",

        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This source-reported employment result follows a residential and mentoring program for eligible youth ages 16–18. It does not establish effects for other youth populations or delivery models.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

        },
        "value": {
          "type": "text",
          "value": "Three years after random assignment, Youth ChalleNGe participants were 7 percentage points more likely to be employed (58% versus 51%).",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

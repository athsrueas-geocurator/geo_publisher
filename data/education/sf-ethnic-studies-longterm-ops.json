        },
        "value": {
          "type": "text",
          "value": "This full-sample reduced-form RD estimate conditions on being enrolled in the district in year four (robust SE 1.799; N=1,304). The authors classify persistence results as exploratory, and the measure does not capture students who had left the district.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }

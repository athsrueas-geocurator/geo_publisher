    "set": [
      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Workforce programs should be evaluated long enough to capture earnings effects during training and after completion.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Project QUEST’s random-assignment study reports lower average annual earnings in its first two follow-up years and positive differences in years three through nine. The linked findings support judging this program over its reported nine-year horizon, while its single-site design and reported operating cost do not establish a universal payoff or a benefit-cost ratio.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "da4a6c1f9d4446f9832ff3b49a4400ef"
        },
        "value": {

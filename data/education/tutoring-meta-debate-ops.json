        },
        "value": {
          "type": "text",
          "value": "School systems should prioritize tutoring delivered during the school day.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This policy position gives weight to the meta-analysis finding that tutoring delivered during school had larger average impacts than after-school tutoring. It does not establish cost, feasibility, staffing, or the effect of every in-school program.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

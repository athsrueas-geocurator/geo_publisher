        },
        "value": {
          "type": "text",
          "value": "Teacher coaching: pooled instruction and achievement effects (Kraft et al., 2018)",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "Pooled teacher-coaching effects on instructional practice and student achievement from a synthesis of causal studies. Subject and coaching-model subgroups overlap with the overall estimates.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }

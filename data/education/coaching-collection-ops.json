      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Reading the estimates",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "e3e363d1dd294ccb8e6ff3b76d99bc33"
        },
        "value": {
          "type": "text",
          "value": "Effects are in standard-deviation units with robust standard errors. The review includes 60 causal studies; the instruction and achievement pools contain 43 and 31 studies respectively, with overlap. Subject and coaching-model rows are subgroup summaries, not independent replications. A nonsignificant estimate is not evidence of no effect. Open each finding for its study count, effect-size count, source locator and reported significance; do not average these rows together.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      }
    ],
    "unset": []
  },

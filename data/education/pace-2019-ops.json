        },
        "value": {
          "type": "text",
          "value": "The 2013–2015 evaluation assigned 673 girls to an offer of PACE and 452 to referrals for alternative community services. It evaluates a voluntary, nonresidential, year-round academic and social-service package.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }

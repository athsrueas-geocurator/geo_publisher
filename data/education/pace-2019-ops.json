        },
        "value": {
          "type": "text",
          "value": "This regression-adjusted Florida public-school administrative-record result covers the calendar year after study enrollment. It is an attendance outcome, not a graduation effect.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {

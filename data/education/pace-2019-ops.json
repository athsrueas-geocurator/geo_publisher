        },
        "value": {
          "type": "text",
          "value": "The composite requires absence below 10% of enrolled days, no expulsion or suspension, and no core-course failure. It applies only to high-school students and is not observed graduation.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {

          "$bytes": "8405509cc7354655a348591349a5f025"
        },
        "value": {
          "type": "text",
          "value": "Randomized controlled trial; 673 program group and 452 control group.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }

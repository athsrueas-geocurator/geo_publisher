        {
          "propertyId": "a126ca530c8e48d5b88882c734c38935",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "STAR-sized early-grade class reductions can be worth their cost.",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "9b1f76ff9711404c861e59dc3fa7d037",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "Krueger (2003) argues that modest achievement gains can justify reducing classes from 22 to 15 pupils in grades K–3. His earnings-based case is conditional on modeled returns, not observed lifetime benefits.",
          "decimal": null,
          "integer": null,
          "boolean": null
        }
      ]
    },

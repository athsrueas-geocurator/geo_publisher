          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": null,
          "decimal": "1.21",
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "ba643714da274c37a340a7f8396198dc",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "reduced-form initial class-type assignment effect",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "8405509cc7354655a348591349a5f025",
          "spaceId": "dac259bad48a11adf97fe36857d85206",

      "values": [
        {
          "propertyId": "e500e2585a964d2c9df4a47b199616c3",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": null,
          "decimal": "5.36",
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "9b1f76ff9711404c861e59dc3fa7d037",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "Compared with regular classes without a full-time aide, the estimated gain in average Stanford test percentile rank was 5.36 points (class-clustered SE 1.21). Krueger (1999), Table V column 7, reports the effect of initial assignment, not a percentage increase in test scores.",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "c962e0fb4a3148e5ba125144691236a8",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "End of kindergarten",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "84dacbddca6a44079edb5e11a4c66b40",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "Table V, column 7, panel A, p. 512",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "a126ca530c8e48d5b88882c734c38935",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "In Tennessee STAR, small-class assignment raised kindergarten achievement by an estimated 5.36 percentile points.",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "da4a6c1f9d4446f9832ff3b49a4400ef",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": null,
          "decimal": null,

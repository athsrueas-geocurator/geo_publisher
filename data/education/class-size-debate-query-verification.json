      "values": [
        {
          "propertyId": "84dacbddca6a44079edb5e11a4c66b40",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "Section 1, Table 2; Section 3, F59–F60",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "9b1f76ff9711404c861e59dc3fa7d037",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "Krueger (2003) finds that reweighting 277 estimates from 59 studies reveals a positive relationship obscured by counting every estimate equally. This is a contested literature interpretation, not a new experiment.",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "a126ca530c8e48d5b88882c734c38935",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "Counting studies equally strengthens the evidence that smaller classes improve achievement.",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "da4a6c1f9d4446f9832ff3b49a4400ef",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": null,
          "decimal": null,
          "integer": null,
          "boolean": false
        }
      ]
    },

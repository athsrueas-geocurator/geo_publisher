      "values": [
        {
          "propertyId": "9b1f76ff9711404c861e59dc3fa7d037",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "Hanushek (2002) interprets STAR’s advantage as concentrated at initial entry into small classes. He disputes extrapolation to later grades or smaller reductions, rather than claiming that no students benefit.",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "da4a6c1f9d4446f9832ff3b49a4400ef",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": null,
          "decimal": null,
          "integer": null,
          "boolean": false
        },
        {
          "propertyId": "84dacbddca6a44079edb5e11a4c66b40",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "Chapter 2, The Tennessee class size experiment, printed pp. 55–58",
          "decimal": null,
          "integer": null,
          "boolean": null
        },
        {
          "propertyId": "a126ca530c8e48d5b88882c734c38935",
          "spaceId": "dac259bad48a11adf97fe36857d85206",
          "text": "STAR’s early gains do not establish benefits from smaller classes in later grades.",
          "decimal": null,
          "integer": null,
          "boolean": null
        }
      ]
    }

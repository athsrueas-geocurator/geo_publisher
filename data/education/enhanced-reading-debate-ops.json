      {
        "property": {
          "$bytes": "a126ca530c8e48d5b88882c734c38935"
        },
        "value": {
          "type": "text",
          "value": "Supplemental ninth-grade literacy courses should be paired with continuing support when schools seek lasting academic effects.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },
      {
        "property": {
          "$bytes": "9b1f76ff9711404c861e59dc3fa7d037"
        },
        "value": {
          "type": "text",
          "value": "This policy proposition weighs ERO’s first-year reading, GPA, and credit gains against its later nonsignificant GPA estimate after the courses ended. The trial did not test a particular continuation model, so it supports a question about sustained support rather than a proven implementation prescription.",
          "language": {
            "$bytes": "090adac0fca4822e8e719263e67620ec"
          }
        }
      },

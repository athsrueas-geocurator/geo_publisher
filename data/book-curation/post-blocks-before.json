    "content": {
      "values": {
        "nodes": [
          {
            "propertyId": "e3e363d1dd294ccb8e6ff3b76d99bc33",
            "text": "I haven't read this book, but I liked this video by Crimes New Roman. A real hater knows where to spend their time.",
            "spaceId": "d00460c203779d21d96fcfc6102d7a72"

  "zen": {
    "entity": {
      "id": "d0f15b4c079f45ef89651a3f366ce2a4",
      "name": "Zen and the Art of Motorcycle Maintenance: An Inquiry into Values",
      "description": "Robert M. Pirsig's influential philosophical novel frames a father-and-son motorcycle journey across America's Northwest as a meditation on values and how to live.",
      "spaceIds": [
        "0477636ace64280fc43a9f440a502291"
      ],
      "types": [
        {
          "id": "8864304115334498b8ea6c1ae833628e",
          "name": "Book"
        }
      ],
      "values": {
        "nodes": [
          {
            "propertyId": "aa5da9278af44294a8a9b79421762c3a",
            "text": "Robert M. Pirsig blends narrative and philosophy in this modern classic, following a father and his young son on a summer motorcycle trip across the American Northwest. As the miles pass, the journey becomes an intellectual odyssey into questions of quality, reason, and how to live well, interweaving memory and a search for a buried former self. Probing the divide between romantic and classical ways of seeing the world, the book offers a penetrating, deeply personal examination of values and the meaning of a good life.",
            "spaceId": "0477636ace64280fc43a9f440a502291"
          },
          {
            "propertyId": "9b1f76ff9711404c861e59dc3fa7d037",
            "text": "Robert M. Pirsig's influential philosophical novel frames a father-and-son motorcycle journey across America's Northwest as a meditation on values and how to live.",
            "spaceId": "0477636ace64280fc43a9f440a502291"
          },
